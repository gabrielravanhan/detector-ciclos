<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>br.unisagrado</groupId>
    <artifactId>detector-ciclos</artifactId>
    <version>0.1.0</version>
    <packaging>jar</packaging>

    <name>Detector de Ciclos de Dependência</name>
    <description>Detecção de ciclos de dependência entre pacotes Java com o algoritmo de Malgrange</description>

    <properties>
        <java.version>25</java.version>
    </properties>

    <dependencies>
        <!-- Servidor web (rotas REST e arquivos da interface). Não é biblioteca de grafos. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- Cytoscape.js empacotado como webjar: a interface desenha o grafo sem depender de internet.
             Ele só desenha; nenhum cálculo de grafo é feito no navegador. -->
        <dependency>
            <groupId>org.webjars.npm</groupId>
            <artifactId>cytoscape</artifactId>
            <version>3.30.2</version>
        </dependency>
        <!-- Layout fCoSE para o Cytoscape: só decide a POSIÇÃO dos vértices na tela, separando as
             caixas de pacotes sem sobreposição. Traz junto o layout-base e o cose-base. -->
        <dependency>
            <groupId>org.webjars.npm</groupId>
            <artifactId>cytoscape-fcose</artifactId>
            <version>2.2.0</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- MockMvc: testa as rotas sem abrir uma porta de rede -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <!-- Gera um único jar executável, com todas as dependências dentro -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
